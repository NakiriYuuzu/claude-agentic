# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxx

# Context7 API Key (Optional, for MCP integration)
CONTEXT7_API_KEY=ctx7_xxx

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/settings.db

# Logging Configuration
# Log level: debug, info, warn, error (development: debug, production: info)
LOG_LEVEL=info
# Pretty print logs in development (true/false)
LOG_PRETTY=true

# Security (Optional)
# ALLOWED_WORKSPACES=/Users/yuuzu/projects,/var/workspaces
# API_KEY=your-api-key-here
