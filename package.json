{
    "name": "claude-agentic-workspace",
    "version": "0.5.0",
    "private": true,
    "type": "module",
    "description": "Claude Agent SDK + Elysia.js + SQLite API Platform - Monorepo",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --filter '*' dev",
        "build": "bun --filter @workspace/shared build && bun --filter @workspace/backend build",
        "build:shared": "bun --filter @workspace/shared build",
        "build:backend": "bun --filter @workspace/backend build",
        "start": "bun --filter @workspace/backend start",
        "test": "bun test",
        "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "bun-types": "latest"
    }
}
