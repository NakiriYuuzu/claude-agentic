{
    "name": "@workspace/backend",
    "version": "0.5.0",
    "type": "module",
    "description": "Backend API service with Elysia.js and Claude SDK",
    "main": "./dist/index.js",
    "scripts": {
        "build": "tsc && tsc-alias",
        "dev": "bun run --watch src/index.ts",
        "start": "bun run dist/index.js",
        "test": "bun test"
    },
    "dependencies": {
        "@workspace/shared": "workspace:*",
